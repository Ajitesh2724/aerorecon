# ═══════════════════════════════════════════════════════════════
#  AeroRecon — Environment Configuration
#  Copy to .env and edit as needed.
# ═══════════════════════════════════════════════════════════════

# Application
DEBUG=false
HOST=0.0.0.0
PORT=8000

# External tool paths (leave blank to auto-detect from PATH)
COLMAP_PATH=
FFMPEG_PATH=

# GPU
USE_GPU=true
GPU_DEVICE=0

# Video processing limits
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_DURATION_S=600
TARGET_KEYFRAME_COUNT=100

# AI model selection
DEPTH_MODEL=depth-anything-v2-vits
FLOW_MODEL=raft-small
DETECTION_MODEL=yolov8n-seg

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
